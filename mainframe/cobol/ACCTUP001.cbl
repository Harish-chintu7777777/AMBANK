IDENTIFICATION DIVISION.
PROGRAM-ID. ACCTUP001.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ACCOUNT-NUMBER PIC X(12).
01 WS-TRANSACTION-AMOUNT PIC 9(9)V99.
01 WS-TRANSACTION-TYPE PIC X(3).
01 WS-CURRENCY-CODE PIC X(3).
01 WS-RESPONSE-CODE PIC 9(4).
01 WS-RESPONSE-TEXT PIC X(50).
01 WS-ADABAS-RESPONSE PIC 9(4).

PROCEDURE DIVISION.
    PERFORM READ-INPUT
    PERFORM VALIDATE-INPUT
    CALL 'ACCTRD001' USING WS-ACCOUNT-NUMBER 'R' WS-RESPONSE-CODE
                          WS-RESPONSE-TEXT WS-ADABAS-RESPONSE
    PERFORM UPDATE-ACCOUNT
    CALL 'TXNWRT001' USING WS-ACCOUNT-NUMBER 'C10001' 
                          WS-TRANSACTION-AMOUNT WS-TRANSACTION-TYPE
                          WS-CURRENCY-CODE WS-RESPONSE-CODE
                          WS-RESPONSE-TEXT WS-ADABAS-RESPONSE
    PERFORM WRITE-OUTPUT
    GOBACK.

READ-INPUT.
    DISPLAY 'ENTER ACCOUNT NUMBER: '.
    ACCEPT WS-ACCOUNT-NUMBER.
    DISPLAY 'ENTER TRANSACTION AMOUNT: '.
    ACCEPT WS-TRANSACTION-AMOUNT.
    DISPLAY 'ENTER TRANSACTION TYPE (DEP/WTH): '.
    ACCEPT WS-TRANSACTION-TYPE.
    MOVE 'USD' TO WS-CURRENCY-CODE.

VALIDATE-INPUT.
    IF WS-ACCOUNT-NUMBER = SPACES
        MOVE 'ERROR: ACCOUNT NUMBER REQUIRED' TO WS-RESPONSE-TEXT
        MOVE 1010 TO WS-RESPONSE-CODE
        GOBACK.
    IF WS-TRANSACTION-AMOUNT = 0
        MOVE 'ERROR: TRANSACTION AMOUNT REQUIRED' TO WS-RESPONSE-TEXT
        MOVE 1011 TO WS-RESPONSE-CODE
        GOBACK.
IF WS-CURRENCY-CODE NOT = 'USD' AND NOT = 'EUR' AND NOT = 'GBP'
        MOVE 'ERROR: INVALID CURRENCY CODE' TO WS-RESPONSE-TEXT
        MOVE 1012 TO WS-RESPONSE-CODE
        GOBACK
UPDATE-ACCOUNT.
    DISPLAY 'UPDATING ACCOUNT: ' WS-ACCOUNT-NUMBER.
    MOVE 0000 TO WS-RESPONSE-CODE.
    MOVE 'ACCOUNT UPDATED' TO WS-RESPONSE-TEXT.

WRITE-OUTPUT.
    DISPLAY 'TRANSACTION RESPONSE CODE: ' WS-RESPONSE-CODE.
    DISPLAY 'TRANSACTION RESPONSE TEXT: ' WS-RESPONSE-TEXT.
    DISPLAY 'ADABAS RESPONSE: ' WS-ADABAS-RESPONSE.
