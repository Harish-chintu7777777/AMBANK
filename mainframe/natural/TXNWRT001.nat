* ============================================================
* NAME     : TXNWRT001
* TYPE     : Subprogram (CALLNAT target)
* LIBRARY  : AMBNATLIB
* OBJECT   : TXNWRT001
* PURPOSE  : Transaction Write Subprogram. Writes transactions to
*            FILE 300 (TRANSACTION MASTER) and updates account
*            balance in FILE 100 (ACCOUNT MASTER) using hold mode.
* CALLED BY: ACCTUP001 (account update online)
*            BRNPOS001 (branch position batch)
* DEPENDS  : FILE 300 AMB-COREBKG-TRANSACTION (write)
*            FILE 100 AMB-COREBKG-ACCOUNT (update via ACCTRD001)
* ADABAS   : FILE 300 — STORE new transaction record
*            FILE 100 — CALL ACCTRD001 with HOLD mode for balance update
* CALL DEPTH: Level 2 (called by Level 1 drivers)
* ============================================================
DEFINE DATA
  PARAMETER USING AMTX001
  LOCAL
    1 TXN-VIEW VIEW OF AMB-COREBKG-TRANSACTION
      2 TA    /* TRANSACTION-ID
      2 TB    /* ACCOUNT-NUMBER
      2 TC    /* CUSTOMER-ID
      2 TD    /* TRANSACTION-DATE
      2 TE    /* TRANSACTION-TIME
      2 TF    /* TRANSACTION-TYPE
      2 TG    /* TRANSACTION-STATUS
      2 TH    /* TRANSACTION-AMOUNT
      2 TI    /* BALANCE-AFTER
      2 TJ    /* CURRENCY-CODE
      2 TK    /* REFERENCE-NUMBER
      2 TL    /* DESCRIPTION
      2 TM    /* POSTING-DATE
      2 TN    /* VALUE-DATE
      2 TO    /* CHANNEL-CODE
      2 TP    /* USER-ID
      2 TQ    /* TERMINAL-ID
END-DEFINE

* ── Input validation ───────────────────────────────────────
IF #P-ACCOUNT-NUMBER = ' '
  MOVE 1010 TO #P-RESPONSE-CODE
  MOVE 'ACCOUNT NUMBER IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-TRANSACTION-AMOUNT = 0
  MOVE 1011 TO #P-RESPONSE-CODE
  MOVE 'TRANSACTION AMOUNT IS ZERO' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

* ── Generate transaction ID ─────────────────────────────────
MOVE 'T' TO #P-TRANSACTION-ID(1:1)
MOVE *DATN TO #P-TRANSACTION-ID(2:8)
MOVE *TIMN TO #P-TRANSACTION-ID(10:3)

* ── Set transaction details ─────────────────────────────────
MOVE *DATN TO TXN-VIEW.TD    /* Transaction date
MOVE *TIMN TO TXN-VIEW.TE    /* Transaction time
MOVE 'PEN' TO TXN-VIEW.TG   /* Pending status
MOVE #P-TRANSACTION-AMOUNT TO TXN-VIEW.TH
MOVE #P-TRANSACTION-TYPE TO TXN-VIEW.TF
MOVE #P-ACCOUNT-NUMBER TO TXN-VIEW.TB
MOVE #P-CUSTOMER-ID TO TXN-VIEW.TC
MOVE #P-CURRENCY-CODE TO TXN-VIEW.TJ
MOVE #P-REFERENCE-NUMBER TO TXN-VIEW.TK
MOVE #P-DESCRIPTION TO TXN-VIEW.TL
MOVE *DATN TO TXN-VIEW.TM    /* Posting date
MOVE *DATN TO TXN-VIEW.TN    /* Value date
MOVE #P-CHANNEL-CODE TO TXN-VIEW.TO
MOVE #P-USER-ID TO TXN-VIEW.TP
MOVE #P-TERMINAL-ID TO TXN-VIEW.TQ

* ── Store transaction to FILE 300 ──────────────────────────
STORE TXN-VIEW

IF *ADABAS-RESPONSE NE 0
  MOVE *ADABAS-RESPONSE  TO #P-ADABAS-RESPONSE
  MOVE 9001              TO #P-RESPONSE-CODE
  MOVE 'STORE FAILED ON FILE 300' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

* ── Update account balance using ACCTRD001 with HOLD mode ──────
CALLNAT 'ACCTRD001' USING #P-ACCOUNT-NUMBER 'H' #P-RESPONSE-CODE
                         #P-RESPONSE-TEXT #P-ADABAS-RESPONSE
                         #SYS-LAST-ADABAS-RESPONSE #SYS-LAST-ERROR-PROGRAM
                         #P-ACCOUNT-RECORD

IF #P-RESPONSE-CODE NE 0
  MOVE 9002 TO #P-RESPONSE-CODE
  MOVE 'ACCOUNT READ FAILED FOR BALANCE UPDATE' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

* ── Update balance based on transaction type ─────────────────
IF #P-TRANSACTION-TYPE = 'DEP'
  ADD #P-TRANSACTION-AMOUNT TO #P-ACCOUNT-RECORD.#P-AVAILABLE-BALANCE
  ADD #P-TRANSACTION-AMOUNT TO #P-ACCOUNT-RECORD.#P-CURRENT-BALANCE
ELSE IF #P-TRANSACTION-TYPE = 'WTH'
  SUBTRACT #P-TRANSACTION-AMOUNT FROM #P-ACCOUNT-RECORD.#P-AVAILABLE-BALANCE
  SUBTRACT #P-TRANSACTION-AMOUNT FROM #P-ACCOUNT-RECORD.#P-CURRENT-BALANCE
END-IF

MOVE #P-ACCOUNT-RECORD.#P-AVAILABLE-BALANCE TO TXN-VIEW.TI

* ── Update account record with new balance ───────────────────
UPDATE USING #P-ACCOUNT-RECORD

IF *ADABAS-RESPONSE NE 0
  MOVE *ADABAS-RESPONSE  TO #P-ADABAS-RESPONSE
  MOVE 9003              TO #P-RESPONSE-CODE
  MOVE 'UPDATE FAILED ON FILE 100' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

* ── Update transaction status to COMPLETED ───────────────────
MOVE 'COM' TO TXN-VIEW.TG
UPDATE TXN-VIEW

IF *ADABAS-RESPONSE NE 0
  MOVE *ADABAS-RESPONSE  TO #P-ADABAS-RESPONSE
  MOVE 9004              TO #P-RESPONSE-CODE
  MOVE 'UPDATE FAILED ON FILE 300' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

MOVE 0000 TO #P-RESPONSE-CODE
MOVE 'TRANSACTION COMPLETED SUCCESSFULLY' TO #P-RESPONSE-TEXT
MOVE 0 TO #P-ADABAS-RESPONSE

ESCAPE ROUTINE

END
